  <!-- 3D Velodyne VLP-16 LiDAR Sensor -->
  <gazebo reference="laser">
    <sensor name="velodyne" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <topic>lidar</topic>
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <gz_frame_id>laser</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>440</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>100.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>



  <!-- This is the ultrasonic sensor -->
  <xacro:macro name="ultrasonic_sensor" params="name">
    <gazebo reference="${name}">
      <sensor name="${name}" type="gpu_lidar">
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>0</visualize>
        <topic>${name}/data</topic>
        <pose>0 0 0 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.1309</min_angle>
              <max_angle>0.1309</max_angle>
            </horizontal>
            <vertical>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.01</min_angle>
              <max_angle>0.01</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.03</min>
            <max>4.1</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:ultrasonic_sensor name="ultrasonic_rl" />
  <xacro:ultrasonic_sensor name="ultrasonic_rr" />

