<?xml version="1.0"?>
<robot name="person_walking" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="person_mass" value="10.0" />
  <xacro:property name="person_height" value="2.0" />
  <xacro:property name="person_radius" value="0.3" />
  <xacro:property name="person_mesh" value="file://$(find lid_description)/meshes/person_walking/meshes/walking.dae" />

  <link name="base_footprint_person"/>

  <joint name="base_joint_person" type="fixed">
    <parent link="base_footprint_person"/>
    <child link="base_link_person"/>
    <!-- Elevate base_link so wheels rest flush on ground level -->
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="base_link_person">
    <inertial>
      <mass value="${person_mass}"/>
      <origin xyz="0 0 ${person_height / 2.0}" rpy="0 0 0"/>
      <inertia ixx="5.0" ixy="0.0" ixz="0.0" iyy="5.0" iyz="0.0" izz="1.0"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.57"/>
      <geometry>
        <mesh filename="${person_mesh}" scale="1 1 1"/>
      </geometry>
    </visual>

    <!-- Visual person body collision omitted or simplified to avoid ground clipping -->
    <collision>
      <origin xyz="0 0 ${person_height / 2.0}" rpy="0 0 1.57"/>
      <geometry>
        <cylinder radius="${person_radius}" length="${person_height}"/>
        <!-- <mesh filename="${person_mesh}" scale="1 1 1"/> -->
      </geometry>
    </collision>
  </link>

  <!-- ============================================== -->
  <!-- 4-WHEEL MACRO DEFINITION                       -->
  <!-- ============================================== -->
  <xacro:macro name="fake_wheel" params="prefix x_offset y_offset">
    <link name="${prefix}_wheel">
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
      <!-- Invisible collision sphere for physics -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.15"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="${prefix}_joint" type="continuous">
      <parent link="base_link_person"/>
      <child link="${prefix}_wheel"/>
      <!-- Wheel center is 0.15m below base_link_person to reach ground (z=0) -->
      <origin xyz="${x_offset} ${y_offset} -0.15" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Instantiate 4 Fake Wheels (Front/Rear, Left/Right) -->
  <xacro:fake_wheel prefix="fl" x_offset="0.2" y_offset="0.25"/>
  <xacro:fake_wheel prefix="fr" x_offset="0.2" y_offset="-0.25"/>
  <xacro:fake_wheel prefix="rl" x_offset="-0.2" y_offset="0.25"/>
  <xacro:fake_wheel prefix="rr" x_offset="-0.2" y_offset="-0.25"/>

  <!-- ============================================== -->
  <!-- GAZEBO PLUGINS                                 -->
  <!-- ============================================== -->
  <gazebo>
    <!-- Diff Drive System (Configured for 4-wheel Skid Steer) -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <!-- Left side wheels -->
      <left_joint>fl_joint</left_joint>
      <left_joint>rl_joint</left_joint>

      <!-- Right side wheels -->
      <right_joint>fr_joint</right_joint>
      <right_joint>rr_joint</right_joint>

      <!-- Kinematic dimensions -->
      <wheel_separation>0.50</wheel_separation>
      <wheel_radius>0.15</wheel_radius>

      <!-- Limits -->
      <max_linear_acceleration>3.20</max_linear_acceleration>
      <max_angular_acceleration>3.20</max_angular_acceleration>

      <topic>cmd_vel_person</topic>
      <odom_topic>/odom_person</odom_topic>
      <tf_topic>/tf_person</tf_topic>
      <frame_id>odom_person</frame_id>
      <child_frame_id>base_footprint_person</child_frame_id>
    </plugin>

    <!-- Joint State Publisher plugin for publishing wheel transforms -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states_person</topic>
    </plugin>
  </gazebo>

</robot>